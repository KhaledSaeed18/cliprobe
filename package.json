{
    "name": "cliprobe",
    "version": "0.3.0",
    "description": "Black-box test any command-line program for terminal-edge bugs: crashes on a closed pipe (| head), color and control codes leaking into pipes, hangs waiting on stdin, broken Ctrl-C handling, and control characters from file names reaching your terminal.",
    "type": "module",
    "bin": {
        "cliprobe": "dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "node src/cli/main.ts",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --type-aware --deny-warnings",
        "lint:fix": "oxlint --type-aware --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test:coverage && pnpm check:package",
        "check:package": "publint --strict",
        "prepublishOnly": "pnpm build",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky"
    },
    "keywords": [
        "cli",
        "testing",
        "epipe",
        "sigpipe",
        "broken-pipe",
        "black-box",
        "conformance",
        "terminal",
        "agent-ready",
        "no-color",
        "sigint",
        "ctrl-c",
        "terminal-injection",
        "pty",
        "stdin",
        "hang"
    ],
    "author": {
        "name": "Khaled Saeed",
        "url": "https://github.com/KhaledSaeed18"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "os": [
        "darwin",
        "linux"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KhaledSaeed18/cliprobe.git"
    },
    "bugs": {
        "url": "https://github.com/KhaledSaeed18/cliprobe/issues"
    },
    "homepage": "https://github.com/KhaledSaeed18/cliprobe#readme",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^5.1.0",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "fast-xml-parser": "^5.12.0",
        "husky": "^9.1.7",
        "markdown-it": "^15.0.3",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "semantic-release": "^25.0.9",
        "tsdown": "^0.23.1",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@12.14.0"
}
