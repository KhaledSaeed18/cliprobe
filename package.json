{
  "name": "cliprobe",
  "version": "0.0.1",
  "description": "Black-box test any command-line program for terminal-edge bugs. 0.0.1 checks whether it crashes when its stdout is closed early (| head, grep -q, agents).",
  "type": "module",
  "bin": {
    "cliprobe": "bin/cliprobe.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "cli",
    "testing",
    "epipe",
    "sigpipe",
    "broken-pipe",
    "black-box",
    "conformance",
    "terminal",
    "agent-ready"
  ],
